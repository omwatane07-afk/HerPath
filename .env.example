# HERPATH Environment Configuration
# All external services are optional. If not configured, HERPATH runs in full local demo mode.

# Geoapify API (Optional - unlocks live Geoapify routing, geocoding & bright-smooth map tiles)
# Documentation: https://apidocs.geoapify.com/
NEXT_PUBLIC_GEOAPIFY_API_KEY=

# OpenWeatherMap API (Optional - unlocks real-time journey weather & safety advisories)
# Documentation: https://openweathermap.org/api
OPENWEATHER_API_KEY=
NEXT_PUBLIC_OPENWEATHER_API_KEY=

# Supabase (Optional for persistent backend & real-time sync)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Map & Routing Configuration (Optional custom endpoints)
# Defaults to public OpenStreetMap tiles & OSRM public demo server
NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
NEXT_PUBLIC_OSRM_API_URL=https://router.project-osrm.org
NEXT_PUBLIC_NOMINATIM_API_URL=https://nominatim.openstreetmap.org

# Emergency Services Contact (Region-specific defaults)
NEXT_PUBLIC_DEFAULT_EMERGENCY_NUMBER=112
NEXT_PUBLIC_WOMEN_HELPLINE_NUMBER=1091
